        },
        {
            ""name"": ""accommodation_type"",
            ""type"": ""string"",
            ""description"": ""what is the type of the hotel"",
            ""possible_values"": [ ""guesthouse"", ""guest house"", ""hotel"" ]
        },
 .... 
